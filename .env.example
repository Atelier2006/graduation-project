# このファイルを .env という名前でコピーして、値を書き換える（.env は Git に入れない）

# 開発中は True。展示会などで公開するときは False にし、SECRET_KEY を必ず設定する
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# データベース：何も書かなければ SQLite（db.sqlite3）。MySQL を使うときは次の行の # を外す
# DB_ENGINE=mysql
# DB_NAME=sagisim
# DB_USER=sagisim
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
